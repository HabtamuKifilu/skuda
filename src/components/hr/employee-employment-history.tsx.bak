"use client";

import { useCallback, useEffect, useState } from "react";
import { BriefcaseBusiness, History, RefreshCw } from "lucide-react";

type HistoryEntry = {
  id: string;
  changeType: string;
  effectiveDate: string;
  previousJobTitle: string | null;
  newJobTitle: string | null;
  previousDepartment: string | null;
  newDepartment: string | null;
  description: string | null;
  notes: string | null;
  createdAt: string;
};

const labels: Record<string, string> = {
  HIRED: "Employee registered",
  PROMOTION: "Promotion",
  TRANSFER: "Role and department change",
  CONTRACT_STARTED: "Contract started",
  CONTRACT_RENEWED: "Contract renewed",
  CONTRACT_CHANGED: "Employment terms changed",
  ROLE_CHANGED: "Job title changed",
  DEPARTMENT_CHANGED: "Department changed",
  OTHER: "Employment update",
};

function formatDate(value: string) {
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? "Date not recorded"
    : new Intl.DateTimeFormat("en", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }).format(date);
}

export function EmployeeEmploymentHistory({
  schoolId,
  staffId,
}: {
  schoolId: string;
  staffId: string;
}) {
  const endpoint =
    `/api/schools/${encodeURIComponent(schoolId)}` +
    `/staff/${encodeURIComponent(staffId)}/employment-history`;

  const [entries, setEntries] = useState<HistoryEntry[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const loadHistory = useCallback(async (signal?: AbortSignal) => {
    setLoading(true);
    setError("");

    try {
      const response = await fetch(endpoint, {
        cache: "no-store",
        signal,
      });
      const result = await response.json();

      if (!response.ok) {
        throw new Error(
          typeof result?.error === "string"
            ? result.error
            : "Unable to load employment history.",
        );
      }

      setEntries(Array.isArray(result.history) ? result.history : []);
    } catch (err) {
      if (err instanceof Error && err.name === "AbortError") return;
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load employment history.",
      );
    } finally {
      if (!signal?.aborted) setLoading(false);
    }
  }, [endpoint]);

  useEffect(() => {
    const controller = new AbortController();
    void loadHistory(controller.signal);
    return () => controller.abort();
  }, [loadHistory]);

  return (
    <section className="overflow-hidden rounded-xl border border-border bg-card">
      <div className="flex items-start justify-between gap-4 border-b border-border px-5 py-4 sm:px-6">
        <div>
          <div className="flex items-center gap-2">
            <History className="size-4 text-muted-foreground" />
            <h2 className="font-semibold">Employment history</h2>
          </div>
          <p className="mt-1 text-sm text-muted-foreground">
            A chronological record of recorded career and contract changes.
          </p>
        </div>
        <span className="shrink-0 rounded-md border border-border px-2.5 py-1 text-xs tabular-nums text-muted-foreground">
          {entries.length} {entries.length === 1 ? "event" : "events"}
        </span>
      </div>

      <div className="p-5 sm:p-6">
        {loading ? (
          <p className="text-sm text-muted-foreground">
            Loading employment history…
          </p>
        ) : error ? (
          <div className="flex items-center justify-between gap-3 rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-sm">
            <p className="text-destructive">{error}</p>
            <button
              type="button"
              onClick={() => void loadHistory()}
              className="inline-flex shrink-0 items-center gap-1.5 font-medium hover:underline"
            >
              <RefreshCw className="size-3.5" />
              Retry
            </button>
          </div>
        ) : entries.length === 0 ? (
          <div className="rounded-lg border border-dashed border-border px-4 py-8 text-center">
            <BriefcaseBusiness className="mx-auto size-5 text-muted-foreground" />
            <p className="mt-3 text-sm font-medium">
              No history recorded yet
            </p>
            <p className="mt-1 text-sm text-muted-foreground">
              Role, department, and contract changes recorded from now on will
              appear here.
            </p>
          </div>
        ) : (
          <ol className="space-y-0">
            {entries.map((entry, index) => (
              <li
                key={entry.id}
                className="relative flex gap-3 pb-6 last:pb-0"
              >
                <div className="flex w-5 shrink-0 flex-col items-center">
                  <span className="mt-1.5 size-2.5 rounded-full border-2 border-primary bg-background" />
                  {index < entries.length - 1 ? (
                    <span className="mt-1 w-px flex-1 bg-border" />
                  ) : null}
                </div>

                <div className="min-w-0 flex-1 pb-1">
                  <div className="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                    <p className="text-sm font-semibold">
                      {labels[entry.changeType] ??
                        entry.changeType.replaceAll("_", " ")}
                    </p>
                    <time
                      dateTime={entry.effectiveDate}
                      className="shrink-0 text-xs text-muted-foreground"
                    >
                      Effective {formatDate(entry.effectiveDate)}
                    </time>
                  </div>

                  {entry.previousJobTitle !== entry.newJobTitle &&
                  (entry.previousJobTitle || entry.newJobTitle) ? (
                    <p className="mt-2 text-sm">
                      <span className="text-muted-foreground">
                        Job title: {entry.previousJobTitle || "Unassigned"}
                      </span>
                      {" → "}
                      <span className="font-medium">
                        {entry.newJobTitle || "Unassigned"}
                      </span>
                    </p>
                  ) : null}

                  {entry.previousDepartment !== entry.newDepartment &&
                  (entry.previousDepartment || entry.newDepartment) ? (
                    <p className="mt-1 text-sm">
                      <span className="text-muted-foreground">
                        Department: {entry.previousDepartment || "Unassigned"}
                      </span>
                      {" → "}
                      <span className="font-medium">
                        {entry.newDepartment || "Unassigned"}
                      </span>
                    </p>
                  ) : null}

                  {entry.description ? (
                    <p className="mt-2 whitespace-pre-wrap text-sm text-muted-foreground">
                      {entry.description}
                    </p>
                  ) : null}

                  {entry.notes ? (
                    <p className="mt-2 whitespace-pre-wrap rounded-md bg-muted/40 px-3 py-2 text-sm text-muted-foreground">
                      {entry.notes}
                    </p>
                  ) : null}

                  <p className="mt-2 text-xs text-muted-foreground">
                    Recorded {formatDate(entry.createdAt)}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  );
}
