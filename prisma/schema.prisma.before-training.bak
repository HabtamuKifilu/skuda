// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model StaffAttendance {
  id             String                @id @default(cuid())
  staffProfileId String
  date           DateTime
  status         StaffAttendanceStatus
  minutesLate    Int?
  note           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, date])
  @@index([staffProfileId])
  @@index([date])
  @@index([status])
}

enum StaffLeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum StaffLeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffLeaveRequest {
  id             String                 @id @default(cuid())
  schoolId       String
  staffProfileId String
  leaveType      StaffLeaveType
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         StaffLeaveRequestStatus @default(PENDING)
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  requestedBy  User         @relation("StaffLeaveRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("StaffLeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, status, startDate])
  @@index([schoolId, staffProfileId, startDate, endDate])
  @@index([schoolId, requestedById])
  @@index([schoolId, reviewedById])
}

model StudentAttendance {
  id           String                  @id @default(cuid())
  enrollmentId String
  date         DateTime
  status       StudentAttendanceStatus
  minutesLate  Int?
  note         String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([enrollmentId])
  @@index([date])
  @@index([status])
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                      @id
  name                          String
  email                         String
  emailVerified                 Boolean                     @default(false)
  role                          String?
  image                         String?
  banned                        Boolean                     @default(false)
  banReason                     String?
  banExpires                    DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  sessions                      Session[]
  accounts                      Account[]
  memberships                   SchoolMembership[]
  platformMemberships           PlatformMembership[]
  studentProfile                StudentProfile?
  guardianProfile               GuardianProfile?
  staffProfile                  StaffProfile?
  requestedStaffAccountAccess   StaffAccountAccessRequest[] @relation("StaffAccountAccessRequester")
  reviewedStaffAccountAccess    StaffAccountAccessRequest[] @relation("StaffAccountAccessReviewer")
  requestedJobAssignmentChanges StaffJobAssignmentRequest[] @relation("JobAssignmentRequester")
  reviewedJobAssignmentChanges  StaffJobAssignmentRequest[] @relation("JobAssignmentReviewer")
  approvedStaffJobAssignments   StaffJobAssignment[]        @relation("StaffJobAssignmentApprover")
  requestedStaffLeaveRequests   StaffLeaveRequest[]         @relation("StaffLeaveRequestRequester")
  reviewedStaffLeaveRequests    StaffLeaveRequest[]         @relation("StaffLeaveRequestReviewer")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum PlatformMembershipRole {
  PLATFORM_OWNER
}

model PlatformMembership {
  id        String                 @id @default(cuid())
  userId    String
  role      PlatformMembershipRole
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@index([isActive])
}

enum SchoolMembershipRole {
  OWNER
  ADMIN
  ACADEMIC_HEAD
  ACCOUNTANT
  TEACHER
  REGISTRAR
  HR_MANAGER
  PARENT
  STUDENT
}

model School {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  code     String? @unique
  email    String?
  phone    String?
  address  String?
  city     String?
  country  String  @default("Ethiopia")
  timezone String  @default("Africa/Addis_Ababa")
  currency String  @default("ETB")
  isActive Boolean @default(true)

  careersMotto             String?
  careersWelcome           String?
  careersMission           String?
  careersValues            String[]       @default([])
  careersWhyJoin           String?
  careersLogoUrl           String?
  careersCoverImageUrl     String?
  careersBrandColor        String?
  careersBrandingPublished Boolean        @default(false)
  careersPublishedBranding Json?
  careersImages            CareersImage[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  memberships                     SchoolMembership[]
  subscriptions                   Subscription[]
  invoices                        Invoice[]
  academicYears                   AcademicYear[]
  grades                          Grade[]
  subjects                        Subject[]
  students                        StudentProfile[]
  guardians                       GuardianProfile[]
  staffProfiles                   StaffProfile[]
  staffLeaveRequests              StaffLeaveRequest[]
  staffDocuments                  StaffDocument[]
  staffEmployments                StaffEmployment[]
  staffEmploymentHistory          StaffEmploymentHistory[]
  staffOnboardings                StaffOnboarding[]
  staffDocumentRequirements       StaffDocumentRequirement[]
  staffOnboardingRequirements     StaffOnboardingRequirement[]
  staffOnboardingAcknowledgements StaffOnboardingAcknowledgement[]
  staffProbationReviews           StaffProbationReview[]
  staffAccountAccessRequests      StaffAccountAccessRequest[]
  jobTitles                       JobTitle[]
  departments                     Department[]
  staffJobAssignments             StaffJobAssignment[]
  staffJobAssignmentRequests      StaffJobAssignmentRequest[]
  jobOpenings                     JobOpening[]
  jobApplications                 JobApplication[]
  periods                         Period[]
  studyShifts                     StudyShift[]

  @@index([isActive])
}

model StudyShift {
  id            String         @id @default(cuid())
  schoolId      String
  name          String
  code          String
  type          StudyShiftType
  description   String?
  startMinute   Int
  endMinute     Int
  operatingDays Weekday[]      @default([])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, type])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

model SchoolMembership {
  id        String               @id @default(cuid())
  userId    String
  schoolId  String
  role      SchoolMembershipRole
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, role])
  @@index([userId])
  @@index([schoolId])
  @@index([schoolId, role])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms        Term[]
  gradingScale GradingScale?
  sections     Section[]
  enrollments  Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  sequence       Int
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  assessments Assessment[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, sequence])
  @@index([academicYearId])
  @@index([academicYearId, isCurrent])
}

model Grade {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  level       Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections    Section[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, level])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

model Section {
  id             String   @id @default(cuid())
  academicYearId String
  gradeId        String
  studyShiftId   String?
  name           String
  code           String
  capacity       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade            Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  studyShift       StudyShift?       @relation(fields: [studyShiftId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  subjectOfferings SubjectOffering[]
  timetableEntries TimetableEntry[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, code])
  @@index([academicYearId])
  @@index([gradeId])
  @@index([studyShiftId])
  @@index([academicYearId, gradeId])
  @@index([academicYearId, isActive])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offerings SubjectOffering[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

model SubjectOffering {
  id        String   @id @default(cuid())
  sectionId String
  subjectId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]
  timetableEntries   TimetableEntry[]

  @@unique([sectionId, subjectId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([sectionId, isActive])
}

model StudentProfile {
  id            String    @id @default(cuid())
  schoolId      String
  userId        String?
  studentNumber String
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime?
  gender        String?
  admissionDate DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians   StudentGuardian[]
  enrollments Enrollment[]

  @@unique([schoolId, studentNumber])
  @@unique([userId])
  @@index([schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId, lastName, firstName])
}

model GuardianProfile {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String?
  firstName  String
  middleName String?
  lastName   String
  phone      String?
  email      String?
  address    String?
  occupation String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@unique([userId])
  @@index([schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId, lastName, firstName])
}

model StudentGuardian {
  id           String   @id @default(cuid())
  studentId    String
  guardianId   String
  relationship String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student  StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@index([studentId, isPrimary])
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
  CANCELLED
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  academicYearId String
  gradeId        String
  sectionId      String
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student           StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade             Grade               @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section           Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  attendanceRecords StudentAttendance[]
  assessmentResults AssessmentResult[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([academicYearId, gradeId])
  @@index([academicYearId, sectionId])
  @@index([studentId])
  @@index([studentId, status])
  @@index([sectionId])
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  SICK
  APPROVED_ABSENCE
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  INACTIVE
}

enum OnboardingTaskStatus {
  PENDING
  COMPLETED
}

enum StaffOnboardingRequirementType {
  ORIENTATION
  POLICY_ACKNOWLEDGEMENT
}

enum StaffProbationReviewOutcome {
  PENDING
  PASSED
  EXTENDED
  FAILED
}

enum StaffAccountAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffProfile {
  id             String      @id @default(cuid())
  schoolId       String
  userId         String?
  employeeNumber String
  firstName      String
  middleName     String?
  lastName       String
  phone          String?
  email          String?
  dateOfBirth    DateTime?
  gender         String?
  hireDate       DateTime?
  jobTitle       String?
  department     String?
  status         StaffStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  school                       School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                         User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacherAssignments           TeacherAssignment[]
  attendanceRecords            StaffAttendance[]
  leaveRequests                StaffLeaveRequest[]
  employment                   StaffEmployment?
  employmentHistory            StaffEmploymentHistory[]
  documents                    StaffDocument[]
  onboarding                   StaffOnboarding?
  probationReviews             StaffProbationReview[]
  accountAccessRequests        StaffAccountAccessRequest[]
  jobAssignments               StaffJobAssignment[]        @relation("StaffAssignmentEmployee")
  managedJobAssignments        StaffJobAssignment[]        @relation("StaffAssignmentManager")
  jobAssignmentRequests        StaffJobAssignmentRequest[] @relation("JobAssignmentRequestEmployee")
  managedJobAssignmentRequests StaffJobAssignmentRequest[] @relation("JobAssignmentRequestManager")

  @@unique([schoolId, employeeNumber])
  @@unique([userId])
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
  PROBATION
  INTERN
  VOLUNTEER
}

enum EmploymentChangeType {
  HIRED
  PROMOTION
  TRANSFER
  CONTRACT_STARTED
  CONTRACT_RENEWED
  CONTRACT_CHANGED
  ROLE_CHANGED
  DEPARTMENT_CHANGED
  OTHER
}

enum JobOpeningStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum JobApplicationStage {
  RECEIVED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

model StaffEmployment {
  id                String         @id @default(cuid())
  schoolId          String
  staffProfileId    String         @unique
  employmentType    EmploymentType @default(PERMANENT)
  startDate         DateTime?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  contractReference String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([staffProfileId, schoolId])
  @@index([schoolId])
  @@index([schoolId, employmentType])
  @@index([schoolId, contractEndDate])
}

model StaffEmploymentHistory {
  id                 String               @id @default(cuid())
  schoolId           String
  staffProfileId     String
  changeType         EmploymentChangeType
  effectiveDate      DateTime
  previousJobTitle   String?
  newJobTitle        String?
  previousDepartment String?
  newDepartment      String?
  description        String?
  notes              String?
  createdAt          DateTime             @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, effectiveDate])
  @@index([staffProfileId, effectiveDate])
  @@index([schoolId, changeType])
}

model JobOpening {
  id             String           @id @default(cuid())
  schoolId       String
  title          String
  department     String?
  description    String?
  employmentType EmploymentType   @default(PERMANENT)
  status         JobOpeningStatus @default(DRAFT)
  isPublished    Boolean          @default(false)
  openingDate    DateTime?
  closingDate    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school               School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applications         JobApplication[]
  documentRequirements JobOpeningDocumentRequirement[]

  @@unique([id, schoolId])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, department])
  @@index([schoolId, closingDate])
}

model JobApplication {
  id             String              @id @default(cuid())
  schoolId       String
  jobOpeningId   String
  candidateName  String
  email          String?
  phone          String?
  stage          JobApplicationStage @default(RECEIVED)
  appliedAt      DateTime            @default(now())
  interviewNotes String?
  decisionNotes  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  school     School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  jobOpening JobOpening               @relation(fields: [jobOpeningId, schoolId], references: [id, schoolId], onDelete: Cascade)
  documents  JobApplicationDocument[]

  @@unique([id, schoolId])
  @@index([schoolId, stage, appliedAt])
  @@index([jobOpeningId, stage])
  @@index([schoolId, email])
}

enum TeacherAssignmentStatus {
  ACTIVE
  ENDED
}

model TeacherAssignment {
  id                String                  @id @default(cuid())
  staffProfileId    String
  subjectOfferingId String
  startDate         DateTime
  endDate           DateTime?
  status            TeacherAssignmentStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  staffProfile     StaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  subjectOffering  SubjectOffering  @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  assessments      Assessment[]

  @@index([staffProfileId])
  @@index([subjectOfferingId])
  @@index([staffProfileId, status])
  @@index([subjectOfferingId, status])
}

model Period {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  sequence    Int
  startMinute Int
  endMinute   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([schoolId, name])
  @@unique([schoolId, sequence])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

enum StudyShiftType {
  MORNING
  AFTERNOON
  EVENING
  WEEKEND
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model TimetableEntry {
  id                  String   @id @default(cuid())
  sectionId           String
  periodId            String
  subjectOfferingId   String
  teacherAssignmentId String?
  weekday             Weekday
  room                String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  section           Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  period            Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectOffering   SubjectOffering    @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  teacherAssignment TeacherAssignment? @relation(fields: [teacherAssignmentId], references: [id], onDelete: SetNull)

  @@unique([sectionId, weekday, periodId])
  @@index([sectionId])
  @@index([periodId])
  @@index([subjectOfferingId])
  @@index([teacherAssignmentId])
  @@index([weekday, periodId])
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  PROJECT
  PRACTICAL
  MIDTERM
  FINAL
  OTHER
}

enum AssessmentStatus {
  DRAFT
  MARKING
  SUBMITTED
  REVIEWED
  APPROVED
  PUBLISHED
}

model GradingScale {
  id             String   @id @default(cuid())
  academicYearId String   @unique
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  items        GradingScaleItem[]
}

model GradingScaleItem {
  id             String   @id @default(cuid())
  gradingScaleId String
  label          String
  minPercent     Decimal  @db.Decimal(5, 2)
  maxPercent     Decimal  @db.Decimal(5, 2)
  points         Decimal? @db.Decimal(5, 3)
  description    String?
  sequence       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@unique([gradingScaleId, label])
  @@unique([gradingScaleId, sequence])
  @@index([gradingScaleId])
}

enum AssessmentResultStatus {
  UNMARKED
  SCORED
  ABSENT
  EXCUSED
  EXEMPT
}

model Assessment {
  id                  String           @id @default(cuid())
  termId              String
  subjectOfferingId   String
  teacherAssignmentId String?
  name                String
  type                AssessmentType
  maxScore            Decimal          @db.Decimal(8, 3)
  weight              Decimal          @db.Decimal(5, 2)
  assessmentDate      DateTime?
  status              AssessmentStatus @default(DRAFT)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  term              Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjectOffering   SubjectOffering    @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  teacherAssignment TeacherAssignment? @relation(fields: [teacherAssignmentId], references: [id], onDelete: SetNull)
  results           AssessmentResult[]

  @@index([termId])
  @@index([subjectOfferingId])
  @@index([teacherAssignmentId])
  @@index([termId, subjectOfferingId])
  @@index([status])
}

model AssessmentResult {
  id           String                 @id @default(cuid())
  assessmentId String
  enrollmentId String
  status       AssessmentResultStatus @default(UNMARKED)
  score        Decimal?               @db.Decimal(8, 3)
  feedback     String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, enrollmentId])
  @@index([status])
  @@index([assessmentId])
  @@index([enrollmentId])
}

enum PlanBillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PAST_DUE
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  currency     String   @default("ETB")
  monthlyPrice Decimal  @db.Decimal(12, 2)
  annualPrice  Decimal  @db.Decimal(12, 2)
  maxStudents  Int?
  maxStaff     Int?
  maxAdmins    Int?
  isActive     Boolean  @default(true)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
  @@index([isPublic])
}

model Subscription {
  id                 String             @id @default(cuid())
  schoolId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       PlanBillingCycle   @default(MONTHLY)
  startDate          DateTime
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model Invoice {
  id             String        @id @default(cuid())
  schoolId       String
  subscriptionId String
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(ISSUED)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime      @default(now())
  dueAt          DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
}

model Payment {
  id                String        @id @default(cuid())
  invoiceId         String
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  externalReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@index([externalReference])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  schoolId     String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  success      Boolean  @default(true)
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([schoolId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([success, createdAt])
}

enum CareersImageKind {
  LOGO
  COVER
}

enum ApplicationDocumentType {
  CV
  EDUCATIONAL_CERTIFICATE
  EXPERIENCE_LETTER
  APPLICATION_LETTER
  OTHER
}

enum ApplicationDocumentStatus {
  PENDING
  UPLOADED
  REJECTED
}

model CareersImage {
  id          String           @id @default(cuid())
  schoolId    String
  kind        CareersImageKind
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, kind])
}

model JobOpeningDocumentRequirement {
  id           String                  @id @default(cuid())
  schoolId     String
  jobOpeningId String
  documentType ApplicationDocumentType
  label        String?
  isRequired   Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  jobOpening JobOpening @relation(fields: [jobOpeningId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([jobOpeningId, documentType])
  @@index([schoolId, jobOpeningId])
}

model JobApplicationDocument {
  id               String                    @id @default(cuid())
  schoolId         String
  applicationId    String
  documentType     ApplicationDocumentType
  originalFileName String
  storageKey       String                    @unique
  data             Bytes?
  contentType      String
  sizeBytes        Int
  status           ApplicationDocumentStatus @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  application JobApplication @relation(fields: [applicationId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, applicationId])
  @@index([applicationId, documentType])
  @@index([schoolId, status])
}

enum StaffDocumentType {
  EMPLOYMENT_CONTRACT
  IDENTIFICATION
  EDUCATIONAL_CERTIFICATE
  EXPERIENCE_LETTER
  PROFESSIONAL_CERTIFICATE
  OTHER
}

enum StaffDocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model StaffOnboarding {
  id                    String    @id @default(cuid())
  schoolId              String
  staffProfileId        String    @unique
  startDate             DateTime
  targetCompletionDate  DateTime?
  accountAccessRequired Boolean   @default(false)
  notes                 String?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  school                School                           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile          StaffProfile                     @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  tasks                 StaffOnboardingTask[]
  acknowledgements      StaffOnboardingAcknowledgement[]
  probationReviews      StaffProbationReview[]
  accountAccessRequests StaffAccountAccessRequest[]

  @@unique([id, schoolId])
  @@unique([staffProfileId, schoolId])
  @@index([schoolId, completedAt])
  @@index([schoolId, startDate])
}

model StaffOnboardingTask {
  id           String               @id @default(cuid())
  schoolId     String
  onboardingId String
  title        String
  description  String?
  dueDate      DateTime?
  status       OnboardingTaskStatus @default(PENDING)
  completedAt  DateTime?
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  onboarding StaffOnboarding @relation(fields: [onboardingId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([onboardingId, sortOrder])
}

model StaffOnboardingRequirement {
  id          String                         @id @default(cuid())
  schoolId    String
  code        String
  type        StaffOnboardingRequirementType
  title       String
  description String?
  version     String                         @default("1")
  required    Boolean                        @default(true)
  isActive    Boolean                        @default(true)
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt

  school           School                           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  acknowledgements StaffOnboardingAcknowledgement[]

  @@unique([schoolId, code])
  @@unique([id, schoolId])
  @@index([schoolId, type, isActive])
}

model StaffOnboardingAcknowledgement {
  id               String   @id @default(cuid())
  schoolId         String
  onboardingId     String
  requirementId    String
  acknowledgedById String
  acknowledgedAt   DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())

  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  onboarding  StaffOnboarding            @relation(fields: [onboardingId, schoolId], references: [id, schoolId], onDelete: Cascade)
  requirement StaffOnboardingRequirement @relation(fields: [requirementId, schoolId], references: [id, schoolId], onDelete: Restrict)

  @@unique([onboardingId, requirementId])
  @@index([schoolId, acknowledgedAt])
}

model StaffProbationReview {
  id                 String                      @id @default(cuid())
  schoolId           String
  onboardingId       String
  staffProfileId     String
  probationStartDate DateTime
  probationEndDate   DateTime
  reviewDueDate      DateTime
  outcome            StaffProbationReviewOutcome @default(PENDING)
  reviewedAt         DateTime?
  reviewerId         String?
  nextReviewDate     DateTime?
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  onboarding   StaffOnboarding @relation(fields: [onboardingId, schoolId], references: [id, schoolId], onDelete: Cascade)
  staffProfile StaffProfile    @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, reviewDueDate, outcome])
  @@index([onboardingId, reviewDueDate])
  @@index([staffProfileId, probationEndDate])
}

model StaffAccountAccessRequest {
  id             String                          @id @default(cuid())
  schoolId       String
  onboardingId   String
  staffProfileId String
  requestedById  String
  requestedRole  SchoolMembershipRole
  status         StaffAccountAccessRequestStatus @default(PENDING)
  requestNotes   String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  onboarding   StaffOnboarding @relation(fields: [onboardingId, schoolId], references: [id, schoolId], onDelete: Cascade)
  staffProfile StaffProfile    @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  requestedBy  User            @relation("StaffAccountAccessRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy   User?           @relation("StaffAccountAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([onboardingId, status])
  @@index([staffProfileId, status])
}

model StaffDocumentRequirement {
  id           String            @id @default(cuid())
  schoolId     String
  documentType StaffDocumentType
  title        String
  required     Boolean           @default(true)
  isActive     Boolean           @default(true)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, documentType])
  @@unique([id, schoolId])
  @@index([schoolId, isActive, required])
}

model StaffDocument {
  id               String                    @id @default(cuid())
  schoolId         String
  staffProfileId   String
  documentType     StaffDocumentType
  title            String
  originalFileName String
  contentType      String
  sizeBytes        Int
  data             Bytes
  issueDate        DateTime?
  expiryDate       DateTime?
  notes            String?
  uploadedById     String?
  reviewStatus     StaffDocumentReviewStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, staffProfileId])
  @@index([schoolId, documentType])
  @@index([schoolId, expiryDate])
  @@index([schoolId, reviewStatus])
  @@index([uploadedById])
}

enum StaffJobAssignmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model JobTitle {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments StaffJobAssignment[]
  requests    StaffJobAssignmentRequest[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@index([schoolId, isActive, name])
}

model Department {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments StaffJobAssignment[]
  requests    StaffJobAssignmentRequest[]

  @@unique([schoolId, name])
  @@unique([id, schoolId])
  @@index([schoolId, isActive, name])
}

model StaffJobAssignment {
  id                 String    @id @default(cuid())
  schoolId           String
  staffProfileId     String
  jobTitleId         String
  departmentId       String?
  reportingManagerId String?
  effectiveDate      DateTime
  endDate            DateTime?
  approvedById       String?
  approvalRecordedAt DateTime?
  createdAt          DateTime  @default(now())

  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile     StaffProfile  @relation("StaffAssignmentEmployee", fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  jobTitle         JobTitle      @relation(fields: [jobTitleId, schoolId], references: [id, schoolId], onDelete: Restrict)
  department       Department?   @relation(fields: [departmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  reportingManager StaffProfile? @relation("StaffAssignmentManager", fields: [reportingManagerId, schoolId], references: [id, schoolId], onDelete: Restrict)
  approvedBy       User?         @relation("StaffJobAssignmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, staffProfileId, effectiveDate])
  @@index([schoolId, jobTitleId])
  @@index([schoolId, departmentId])
  @@index([schoolId, reportingManagerId])
}

model StaffJobAssignmentRequest {
  id                 String                          @id @default(cuid())
  schoolId           String
  staffProfileId     String
  jobTitleId         String
  departmentId       String?
  reportingManagerId String?
  effectiveDate      DateTime
  reason             String
  status             StaffJobAssignmentRequestStatus @default(PENDING)
  requestedById      String
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNotes        String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile     StaffProfile  @relation("JobAssignmentRequestEmployee", fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  jobTitle         JobTitle      @relation(fields: [jobTitleId, schoolId], references: [id, schoolId], onDelete: Restrict)
  department       Department?   @relation(fields: [departmentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  reportingManager StaffProfile? @relation("JobAssignmentRequestManager", fields: [reportingManagerId, schoolId], references: [id, schoolId], onDelete: Restrict)
  requestedBy      User          @relation("JobAssignmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy       User?         @relation("JobAssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, staffProfileId, effectiveDate])
  @@index([schoolId, reviewedById])
}
