  description     String?
  category        String
  targetValue     Decimal                      @db.Decimal(12, 2)
  baselineValue   Decimal?                     @db.Decimal(12, 2)
  currentValue    Decimal?                     @db.Decimal(12, 2)
  unit            String?
  successCriteria String?
  priority        StaffPerformanceGoalPriority @default(NORMAL)
  status          StaffPerformanceGoalStatus   @default(DRAFT)
  progress        Int                          @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  school          School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile    StaffProfile                   @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  createdBy       User                           @relation("StaffPerformanceGoalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  progressUpdates StaffPerformanceGoalProgress[]

  @@unique([id, schoolId])
  @@index([schoolId, status, dueDate])
  @@index([schoolId, staffProfileId, status])
  @@index([createdById])
}

model StaffPerformanceGoalProgress {
  id           String   @id @default(cuid())
  schoolId     String
  goalId       String
  progress     Int
  currentValue Decimal? @db.Decimal(12, 2)
  note         String?
  evidence     String?
  recordedById String
  createdAt    DateTime @default(now())

  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  goal       StaffPerformanceGoal @relation(fields: [goalId, schoolId], references: [id, schoolId], onDelete: Cascade)
  recordedBy User                 @relation("PerformanceGoalProgressAuthor", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([schoolId, goalId, createdAt])
  @@index([recordedById])
}

model PerformanceReviewCycle {
  id          String                       @id @default(cuid())
  schoolId    String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      PerformanceReviewCycleStatus @default(DRAFT)
  createdById String
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  school    School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User                     @relation("PerformanceCycleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviews   StaffPerformanceReview[]

  @@unique([id, schoolId])
  @@unique([schoolId, name])
  @@index([schoolId, status, startDate])
  @@index([schoolId, endDate])
  @@index([createdById])
}

model StaffPerformanceReview {
  id               String                       @id @default(cuid())
  schoolId         String
  cycleId          String
  staffProfileId   String
  reviewerId       String
  status           StaffPerformanceReviewStatus @default(DRAFT)
  overallRating    Int?
  strengths        String?
  improvementAreas String?
  reviewerComments String?
  employeeComments String?
  submittedAt      DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  school       School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle        PerformanceReviewCycle       @relation(fields: [cycleId, schoolId], references: [id, schoolId], onDelete: Cascade)
  staffProfile StaffProfile                 @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  reviewer     User                         @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  competencies StaffPerformanceCompetency[]

  @@unique([id, schoolId])
  @@unique([cycleId, staffProfileId])
  @@index([schoolId, status, updatedAt])
  @@index([schoolId, staffProfileId, createdAt])
  @@index([schoolId, reviewerId, status])
}

model StaffPerformanceCompetency {
  id                     String   @id @default(cuid())
  schoolId               String
  reviewId               String
  competency             String
  rating                 Int
  evidence               String?
  frameworkId            String?
  frameworkNameSnapshot  String?
  frameworkCompetencyId  String?
  descriptionSnapshot    String?
  ratingCriteriaSnapshot Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  review StaffPerformanceReview @relation(fields: [reviewId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([reviewId, competency])
  @@index([schoolId, reviewId])
  @@index([schoolId, frameworkId])
}

model StaffPerformanceCompetencyFramework {
  id               String   @id @default(cuid())
  schoolId         String
  name             String
  description      String?
  targetJobTitle   String?
  targetDepartment String?
  isActive         Boolean  @default(true)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school       School                                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  competencies StaffPerformanceCompetencyDefinition[]

  @@unique([id, schoolId])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@index([schoolId, targetJobTitle, targetDepartment])
}

model StaffPerformanceCompetencyDefinition {
  id              String   @id @default(cuid())
  schoolId        String
  frameworkId     String
  name            String
  description     String?
  rating1Criteria String
  rating2Criteria String
  rating3Criteria String
  rating4Criteria String
  rating5Criteria String
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  framework StaffPerformanceCompetencyFramework @relation(fields: [frameworkId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([id, schoolId])
  @@unique([frameworkId, name])
  @@index([schoolId, frameworkId, isActive, sortOrder])
}

enum StaffOffboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  WAIVED
}

enum StaffOffboardingTaskCategory {
  HR_REVIEW
  LEADERSHIP_APPROVAL
  FINANCE_CLEARANCE
  DEPARTMENT_CLEARANCE
  ACADEMIC_HANDOVER
  STUDENT_RECORDS_HANDOVER
  PROPERTY_RETURN
  ASSET_RETURN
  EMPLOYEE_DOCUMENTS
  EXIT_INTERVIEW
  FINAL_SETTLEMENT
  OTHER
}

enum StaffOffboardingAccessType {
  SCHOOL_MEMBERSHIP
  USER_SESSION
  EXTERNAL_SYSTEM
  DEVICE
  PHYSICAL_ACCESS
  OTHER
}

enum StaffOffboardingAccessStatus {
  PENDING
  IN_PROGRESS
  REVOKED
  NOT_APPLICABLE
  FAILED
}

enum StaffOffboardingSettlementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PAYMENT_PENDING
  PAID
  DISPUTED
  CANCELLED
}

enum StaffOffboardingSettlementItemType {
  FINAL_SALARY
  UNUSED_LEAVE_PAYOUT
  APPROVED_EXPENSE
  OUTSTANDING_ADVANCE
  OTHER_ADJUSTMENT
  CONTRACTUAL_BENEFIT
  SEVERANCE
  DEDUCTION
}

model StaffOffboardingTask {
  id              String                       @id @default(cuid())
  schoolId        String
  staffProfileId  String
  offboardingId   String
  category        StaffOffboardingTaskCategory
  title           String
  description     String?
  required        Boolean                      @default(true)
  status          StaffOffboardingTaskStatus   @default(PENDING)
  assignedToId    String?
  dueDate         DateTime?
  completedAt     DateTime?
  completedById   String?
  evidenceRef     String?
  reviewerId      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  exceptionReason String?
  createdById     String
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile     @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  offboarding  StaffOffboarding @relation(fields: [offboardingId, schoolId], references: [id, schoolId], onDelete: Cascade)
  documents    StaffOffboardingTaskDocument[]

  @@index([schoolId, offboardingId, status])
  @@index([schoolId, assignedToId, status])
  @@index([schoolId, dueDate, status])
  @@index([staffProfileId, createdAt])
}

model StaffOffboardingTaskDocument {
  id               String   @id @default(cuid())
  schoolId         String
  taskId           String
  originalFileName String
  contentType      String
  sizeBytes        Int
  data             Bytes
  uploadedById     String
  createdAt        DateTime @default(now())

  school School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  task   StaffOffboardingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([schoolId, taskId, createdAt])
  @@index([uploadedById])
}

model StaffOffboardingAccessRevocation {
  id                String                       @id @default(cuid())
  schoolId          String
  staffProfileId    String
  offboardingId     String
  accessType        StaffOffboardingAccessType
  target            String
  status            StaffOffboardingAccessStatus @default(PENDING)
  required          Boolean                      @default(true)
  requestedById     String
  requestedAt       DateTime                     @default(now())
  verifiedById      String?
  verifiedAt        DateTime?
  outcomeNotes      String?
  externalReference String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile     @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  offboarding  StaffOffboarding @relation(fields: [offboardingId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, offboardingId, status])
  @@index([schoolId, staffProfileId])
  @@index([schoolId, accessType, status])
}

model StaffOffboardingSettlement {
  id                   String                           @id @default(cuid())
  schoolId             String
  staffProfileId       String
  offboardingId        String                           @unique
  status               StaffOffboardingSettlementStatus @default(DRAFT)
  currency             String                           @default("ETB")
  periodStart          DateTime?
  periodEnd            DateTime?
  preparedById         String?
  preparedAt           DateTime?
  reviewedById         String?
  reviewedAt           DateTime?
  approvedById         String?
  approvedAt           DateTime?
  paymentDate          DateTime?
  paymentReference     String?
  paymentEvidenceRef   String?
  employeeAcknowledged Boolean                          @default(false)
  acknowledgedAt       DateTime?
  acknowledgmentRef    String?
  notes                String?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  school       School                           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile                     @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  offboarding  StaffOffboarding                 @relation(fields: [offboardingId, schoolId], references: [id, schoolId], onDelete: Cascade)
  items        StaffOffboardingSettlementItem[]

  @@unique([offboardingId, schoolId])
  @@unique([id, schoolId])
  @@index([schoolId, status, createdAt])
  @@index([staffProfileId, createdAt])
}

model StaffOffboardingSettlementItem {
  id               String                             @id @default(cuid())
  schoolId         String
  settlementId     String
  itemType         StaffOffboardingSettlementItemType
  description      String
  amount           Decimal                            @db.Decimal(14, 2)
  currency         String                             @default("ETB")
  calculationNotes String?
  reference        String?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  school     School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  settlement StaffOffboardingSettlement @relation(fields: [settlementId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, settlementId])
  @@index([schoolId, itemType])
}
