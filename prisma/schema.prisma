// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model StaffAttendance {
  id             String                @id @default(cuid())
  staffProfileId String
  date           DateTime
  status         StaffAttendanceStatus
  minutesLate    Int?
  note           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, date])
  @@index([staffProfileId])
  @@index([date])
  @@index([status])
}

enum StaffLeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum StaffLeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PerformanceReviewCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

enum StaffPerformanceReviewStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  ACKNOWLEDGED
}

enum StaffPerformanceGoalStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StaffPerformanceGoalPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model StaffLeaveRequest {
  id             String                  @id @default(cuid())
  schoolId       String
  staffProfileId String
  leaveType      StaffLeaveType
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         StaffLeaveRequestStatus @default(PENDING)
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  requestedBy  User         @relation("StaffLeaveRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("StaffLeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([id, schoolId])
  @@index([schoolId, status, startDate])
  @@index([schoolId, staffProfileId, startDate, endDate])
  @@index([schoolId, requestedById])
  @@index([schoolId, reviewedById])
}

model StudentAttendance {
  id           String                  @id @default(cuid())
  enrollmentId String
  date         DateTime
  status       StudentAttendanceStatus
  minutesLate  Int?
  note         String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([enrollmentId])
  @@index([date])
  @@index([status])
}

datasource db {
  provider = "postgresql"
}

model User {
  appNotifications               AppNotification[]
  id                             String                         @id
  name                           String
  email                          String
  emailVerified                  Boolean                        @default(false)
  role                           String?
  image                          String?
  banned                         Boolean                        @default(false)
  banReason                      String?
  banExpires                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  sessions                       Session[]
  accounts                       Account[]
  memberships                    SchoolMembership[]
  platformMemberships            PlatformMembership[]
  studentProfile                 StudentProfile?
  guardianProfile                GuardianProfile?
  staffProfile                   StaffProfile?
  requestedStaffAccountAccess    StaffAccountAccessRequest[]    @relation("StaffAccountAccessRequester")
  reviewedStaffAccountAccess     StaffAccountAccessRequest[]    @relation("StaffAccountAccessReviewer")
  requestedJobAssignmentChanges  StaffJobAssignmentRequest[]    @relation("JobAssignmentRequester")
  reviewedJobAssignmentChanges   StaffJobAssignmentRequest[]    @relation("JobAssignmentReviewer")
  approvedStaffJobAssignments    StaffJobAssignment[]           @relation("StaffJobAssignmentApprover")
  requestedStaffLeaveRequests    StaffLeaveRequest[]            @relation("StaffLeaveRequestRequester")
  reviewedStaffLeaveRequests     StaffLeaveRequest[]            @relation("StaffLeaveRequestReviewer")
  createdPerformanceReviewCycles PerformanceReviewCycle[]       @relation("PerformanceCycleCreator")
  assignedPerformanceReviews     StaffPerformanceReview[]       @relation("PerformanceReviewReviewer")
  createdStaffDevelopmentPlans   StaffDevelopmentPlan[]         @relation("StaffDevelopmentPlanCreator")
  createdStaffPerformanceGoals   StaffPerformanceGoal[]         @relation("StaffPerformanceGoalCreator")
  recordedGoalProgressUpdates    StaffPerformanceGoalProgress[] @relation("PerformanceGoalProgressAuthor")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum PlatformMembershipRole {
  PLATFORM_OWNER
}

model PlatformMembership {
  id        String                 @id @default(cuid())
  userId    String
  role      PlatformMembershipRole
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@index([isActive])
}

enum SchoolMembershipRole {
  OWNER
  ADMIN
  ACADEMIC_HEAD
  ACCOUNTANT
  TEACHER
  REGISTRAR
  HR_MANAGER
  PARENT
  STUDENT
}

model School {
  appNotifications AppNotification[]
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  code             String?           @unique
  email            String?
  phone            String?
  address          String?
  city             String?
  country          String            @default("Ethiopia")
  timezone         String            @default("Africa/Addis_Ababa")
  currency         String            @default("ETB")
  isActive         Boolean           @default(true)

  careersMotto             String?
  careersWelcome           String?
  careersMission           String?
  careersValues            String[]       @default([])
  careersWhyJoin           String?
  careersLogoUrl           String?
  careersCoverImageUrl     String?
  careersBrandColor        String?
  careersBrandingPublished Boolean        @default(false)
  careersPublishedBranding Json?
  careersImages            CareersImage[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  memberships                       SchoolMembership[]
  subscriptions                     Subscription[]
  invoices                          Invoice[]
  academicYears                     AcademicYear[]
  grades                            Grade[]
  subjects                          Subject[]
  students                          StudentProfile[]
  guardians                         GuardianProfile[]
  staffProfiles                     StaffProfile[]
  staffOffboardingRecords           StaffOffboarding[]
  staffOffboardingTasks             StaffOffboardingTask[]
  staffOffboardingTaskDocuments StaffOffboardingTaskDocument[]
  staffOffboardingAccessRevocations StaffOffboardingAccessRevocation[]
  staffOffboardingSettlements       StaffOffboardingSettlement[]
  staffOffboardingSettlementItems   StaffOffboardingSettlementItem[]
  staffLeaveRequests                StaffLeaveRequest[]
  staffDocuments                    StaffDocument[]
  staffEmployments                  StaffEmployment[]
  staffEmploymentHistory            StaffEmploymentHistory[]
  staffOnboardings                  StaffOnboarding[]
  staffDocumentRequirements         StaffDocumentRequirement[]
  staffOnboardingRequirements       StaffOnboardingRequirement[]
  staffOnboardingAcknowledgements   StaffOnboardingAcknowledgement[]
  staffProbationReviews             StaffProbationReview[]
  staffAccountAccessRequests        StaffAccountAccessRequest[]
  jobTitles                         JobTitle[]
  departments                       Department[]
  staffJobAssignments               StaffJobAssignment[]
  staffJobAssignmentRequests        StaffJobAssignmentRequest[]
  staffTrainingRecords              StaffTrainingRecord[]
  performanceReviewCycles           PerformanceReviewCycle[]
  performanceCompetencyFrameworks   StaffPerformanceCompetencyFramework[]
  staffPerformanceGoals             StaffPerformanceGoal[]
  staffPerformanceGoalProgress      StaffPerformanceGoalProgress[]
  performanceReviews                StaffPerformanceReview[]
  staffDevelopmentPlans             StaffDevelopmentPlan[]
  jobOpenings                       JobOpening[]
  jobApplications                   JobApplication[]
  periods                           Period[]
  studyShifts                       StudyShift[]

  @@index([isActive])
}

model StudyShift {
  id            String         @id @default(cuid())
  schoolId      String
  name          String
  code          String
  type          StudyShiftType
  description   String?
  startMinute   Int
  endMinute     Int
  operatingDays Weekday[]      @default([])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, type])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

model SchoolMembership {
  id        String               @id @default(cuid())
  userId    String
  schoolId  String
  role      SchoolMembershipRole
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, role])
  @@index([userId])
  @@index([schoolId])
  @@index([schoolId, role])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms        Term[]
  gradingScale GradingScale?
  sections     Section[]
  enrollments  Enrollment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  sequence       Int
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  assessments Assessment[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, sequence])
  @@index([academicYearId])
  @@index([academicYearId, isCurrent])
}

model Grade {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  level       Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections    Section[]
  enrollments Enrollment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@unique([schoolId, level])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

model Section {
  id             String   @id @default(cuid())
  academicYearId String
  gradeId        String
  studyShiftId   String?
  name           String
  code           String
  capacity       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade            Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  studyShift       StudyShift?       @relation(fields: [studyShiftId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  subjectOfferings SubjectOffering[]
  timetableEntries TimetableEntry[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, code])
  @@index([academicYearId])
  @@index([gradeId])
  @@index([studyShiftId])
  @@index([academicYearId, gradeId])
  @@index([academicYearId, isActive])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offerings SubjectOffering[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

model SubjectOffering {
  id        String   @id @default(cuid())
  sectionId String
  subjectId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]
  timetableEntries   TimetableEntry[]

  @@unique([sectionId, subjectId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([sectionId, isActive])
}

model StudentProfile {
  id            String    @id @default(cuid())
  schoolId      String
  userId        String?
  studentNumber String
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime?
  gender        String?
  admissionDate DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians   StudentGuardian[]
  enrollments Enrollment[]

  @@unique([schoolId, studentNumber])
  @@unique([userId])
  @@index([schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId, lastName, firstName])
}

model GuardianProfile {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String?
  firstName  String
  middleName String?
  lastName   String
  phone      String?
  email      String?
  address    String?
  occupation String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@unique([userId])
  @@index([schoolId])
  @@index([schoolId, isActive])
  @@index([schoolId, lastName, firstName])
}

model StudentGuardian {
  id           String   @id @default(cuid())
  studentId    String
  guardianId   String
  relationship String
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student  StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@index([studentId, isPrimary])
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
  CANCELLED
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  academicYearId String
  gradeId        String
  sectionId      String
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student           StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade             Grade               @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section           Section             @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  attendanceRecords StudentAttendance[]
  assessmentResults AssessmentResult[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([academicYearId, gradeId])
  @@index([academicYearId, sectionId])
  @@index([studentId])
  @@index([studentId, status])
  @@index([sectionId])
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  SICK
  APPROVED_ABSENCE
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  INACTIVE
}

enum OnboardingTaskStatus {
  PENDING
  COMPLETED
}

enum StaffOnboardingRequirementType {
  ORIENTATION
  POLICY_ACKNOWLEDGEMENT
}

enum StaffProbationReviewOutcome {
  PENDING
  PASSED
  EXTENDED
  FAILED
}

enum StaffAccountAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffOffboarding {
  id                       String                             @id @default(cuid())
  schoolId                 String
  staffProfileId           String
  exitType                 StaffOffboardingType
  initiator                StaffOffboardingInitiator
  status                   StaffOffboardingStatus             @default(DRAFT)
  reasonCategory           String?
  reasonNotes              String?
  confidentialNotes        String?
  noticeRequired           Boolean                            @default(false)
  noticeGiven              Boolean                            @default(false)
  noticeDate               DateTime?
  submissionDate           DateTime?
  proposedLastDay          DateTime?
  confirmedLastDay         DateTime?
  effectiveTerminationDate DateTime?
  rehireEligible           Boolean?
  rehireDecisionNotes      String?
  rehireDecidedById        String?
  rehireDecidedAt          DateTime?
  responsibleHrId          String?
  approverId               String?
  approvedAt               DateTime?
  rejectedAt               DateTime?
  rejectionReason          String?
  disputePending           Boolean                            @default(false)
  investigationPending     Boolean                            @default(false)
  exitInterviewCompleted   Boolean                            @default(false)
  feedbackNotes            String?
  handoverConfirmed        Boolean                            @default(false)
  createdById              String
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  school                   School                             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile             StaffProfile                       @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)
  tasks                    StaffOffboardingTask[]
  accessRevocations        StaffOffboardingAccessRevocation[]
  settlement               StaffOffboardingSettlement?

  @@unique([id, schoolId])
  @@index([schoolId, status])
  @@index([schoolId, exitType])
  @@index([schoolId, proposedLastDay])
  @@index([staffProfileId, createdAt])
  @@index([schoolId, responsibleHrId])
}

model StaffProfile {
  id             String      @id @default(cuid())
  schoolId       String
  userId         String?
  employeeNumber String
  firstName      String
  middleName     String?
  lastName       String
  phone          String?
  email          String?
  dateOfBirth    DateTime?
  gender         String?
  hireDate       DateTime?
  jobTitle       String?
  department     String?
  status         StaffStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  school                       School                             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                         User?                              @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacherAssignments           TeacherAssignment[]
  attendanceRecords            StaffAttendance[]
  leaveRequests                StaffLeaveRequest[]
  employment                   StaffEmployment?
  employmentHistory            StaffEmploymentHistory[]
  documents                    StaffDocument[]
  onboarding                   StaffOnboarding?
  probationReviews             StaffProbationReview[]
  accountAccessRequests        StaffAccountAccessRequest[]
  jobAssignments               StaffJobAssignment[]               @relation("StaffAssignmentEmployee")
  managedJobAssignments        StaffJobAssignment[]               @relation("StaffAssignmentManager")
  jobAssignmentRequests        StaffJobAssignmentRequest[]        @relation("JobAssignmentRequestEmployee")
  managedJobAssignmentRequests StaffJobAssignmentRequest[]        @relation("JobAssignmentRequestManager")
  trainingRecords              StaffTrainingRecord[]
  developmentPlans             StaffDevelopmentPlan[]
  developmentGoals             StaffDevelopmentGoal[]
  performanceReviews           StaffPerformanceReview[]
  performanceGoals             StaffPerformanceGoal[]
  staffOffboardings            StaffOffboarding[]
  offboardingTasks             StaffOffboardingTask[]
  offboardingAccessRevocations StaffOffboardingAccessRevocation[]
  offboardingSettlements       StaffOffboardingSettlement[]

  @@unique([schoolId, employeeNumber])
  @@unique([userId])
  @@unique([id, schoolId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, lastName, firstName])
}

enum AppNotificationType {
  PERFORMANCE_REVIEW_SUBMITTED
  PERFORMANCE_REVIEW_ACKNOWLEDGED
  PERFORMANCE_REVIEW_REMINDER
  PERFORMANCE_REVIEW_OVERDUE
}

model AppNotification {
  id              String              @id @default(cuid())
  schoolId        String
  recipientUserId String
  type            AppNotificationType
  title           String
  message         String
  href            String?
  dedupeKey       String?
  readAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipient User   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([schoolId, recipientUserId, dedupeKey])
  @@index([recipientUserId, readAt, createdAt])
  @@index([schoolId, recipientUserId, createdAt])
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
  PROBATION
  INTERN
  VOLUNTEER
}

enum StaffOffboardingType {
  RESIGNATION
  RETIREMENT
  FIXED_TERM_END
  REDUNDANCY
  DISMISSAL
  PROBATION_TERMINATION
  MUTUAL_AGREEMENT
  DEATH
  OTHER
}

enum StaffOffboardingInitiator {
  EMPLOYEE
  SCHOOL
  MUTUAL
}

enum StaffOffboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum EmploymentChangeType {
  HIRED
  PROMOTION
  TRANSFER
  CONTRACT_STARTED
  CONTRACT_RENEWED
  CONTRACT_CHANGED
  ROLE_CHANGED
  DEPARTMENT_CHANGED
  OTHER
}

enum JobOpeningStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum JobApplicationStage {
  RECEIVED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

model StaffEmployment {
  id                String         @id @default(cuid())
  schoolId          String
  staffProfileId    String         @unique
  employmentType    EmploymentType @default(PERMANENT)
  startDate         DateTime?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  contractReference String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([staffProfileId, schoolId])
  @@index([schoolId])
  @@index([schoolId, employmentType])
  @@index([schoolId, contractEndDate])
}

model StaffEmploymentHistory {
  id                 String               @id @default(cuid())
  schoolId           String
  staffProfileId     String
  changeType         EmploymentChangeType
  effectiveDate      DateTime
  previousJobTitle   String?
  newJobTitle        String?
  previousDepartment String?
  newDepartment      String?
  description        String?
  notes              String?
  createdAt          DateTime             @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, effectiveDate])
  @@index([staffProfileId, effectiveDate])
  @@index([schoolId, changeType])
}

model JobOpening {
  id             String           @id @default(cuid())
  schoolId       String
  title          String
  department     String?
  description    String?
  employmentType EmploymentType   @default(PERMANENT)
  status         JobOpeningStatus @default(DRAFT)
  isPublished    Boolean          @default(false)
  openingDate    DateTime?
  closingDate    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

